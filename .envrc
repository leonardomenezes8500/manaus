dotenv

# Remoto `r2` do rclone, montado a partir das R2_* do .env (sem copiar valores).
export RCLONE_CONFIG_R2_TYPE=s3
export RCLONE_CONFIG_R2_PROVIDER=Cloudflare
export RCLONE_CONFIG_R2_ACCESS_KEY_ID="${R2_ACCESS_KEY_ID:-}"
export RCLONE_CONFIG_R2_SECRET_ACCESS_KEY="${R2_SECRET_ACCESS_KEY:-}"
export RCLONE_CONFIG_R2_ENDPOINT="https://${R2_ACCOUNT_ID:-}.r2.cloudflarestorage.com"
# o token só tem permissão de objeto: não tentar criar o bucket
export RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true

# Node neste WSL: o happy eyeballs desiste do IPv4 em 250 ms e cai num IPv6 sem rota (ETIMEDOUT/ENETUNREACH).
export NODE_OPTIONS=--network-family-autoselection-attempt-timeout=2000
