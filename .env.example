# Copie para .env (fora do git) e preencha. Só os nomes ficam no repo; os valores vão no .env local e nos secrets do GitHub.

# Chaves das fontes (estado em estado/chaves.md no R2)
FIRMS_MAP_KEY=
OPENAQ_API_KEY=
EARTHDATA_TOKEN=
# a mesma conta ECMWF serve o CDS (clima/ERA5) e o ADS (atmosfera/CAMS)
ECMWF_URL=
ECMWF_KEY=
TRANSPARENCIA_API_KEY=

# Banco: aqui pelo túnel `ssh -fNL 5433:127.0.0.1:5432 slice`; na slice o compose fixa PGHOST, PGUSER e PGDATABASE
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=manaus
PGDATABASE=manaus
PGPASSWORD=

# Cloudflare R2 (token só de objetos, só neste bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Opcionais: pastas de buffer e logs (padrão: pasta temporária do sistema e /dados/logs)
# MANAUS_BUFFER=
# MANAUS_LOGS=

# Opcional: outra BrasilAPI (padrão: https://brasilapi.com.br/api); os testes apontam para um servidor local
# BRASILAPI_URL=

# Opcional: endereço da API (padrão 127.0.0.1:3010; no container, 0.0.0.0:3000)
# API_HOST=
# API_PORT=
