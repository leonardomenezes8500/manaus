{
  "name": "manaus",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "jest --runInBand",
    "tipos": "tsc --noEmit",
    "migrar": "node db/migrar.ts",
    "fumaca": "node analise/fumaca/atribuir.ts",
    "trajetorias": "node analise/trajetoria/trajetorias.ts",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run lint && prettier --check . && npm run tipos && npm test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "jest": {
    "testTimeout": 120000,
    "transform": {
      "^.+\\.ts$": "@swc/jest",
      "/node_modules/cookie/.+\\.js$": "@swc/jest"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!cookie/)"
    ]
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "9.39.5",
    "jest": "^30.5.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/lib-storage": "^3.1155.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1"
  }
}
